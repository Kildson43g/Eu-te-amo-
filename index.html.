<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060208">
<title>Love Heart</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #060208; }
  body { display: grid; place-items: center; }
  canvas { display: block; width: 100vw; height: 100dvh; }
</style>
</head>
<body>
<canvas id="heart" aria-label="Coração formado por frases de amor em vários idiomas"></canvas>
<script>
(() => {
  const canvas = document.getElementById('heart');
  const ctx = canvas.getContext('2d');
  const BG = '#060208';
  const phrases = [
    'I love you', 'Seni seviyorum', 'Te amo', "Je t'aime",
    'Ich liebe dich', 'Ti amo', 'Eu te amo', 'Я тебя люблю',
    '사랑해', '愛してる', '我爱你', 'मैं तुमसे प्यार करता हूँ',
    "Σ'αγαπώ", 'Ik hou van jou', 'Jag älskar dig', 'Kocham cię',
    'ฉันรักเธอ', 'Anh yêu em', 'Aku cinta kamu', 'Я тебе кохаю'
  ];
  const sizes = [9, 10, 11, 12];
  const colors = { wine: [0.58, 0, 0.09], crimson: [0.90, 0.05, 0.14], blood: [0.98, 0.10, 0.16], flash: [1, .78, .78] };
  let rngSeed = 11;
  function rand() { rngSeed = (rngSeed * 1664525 + 1013904223) >>> 0; return rngSeed / 4294967296; }
  function shuffle(a) { for (let i=a.length-1;i>0;i--) { const j=Math.floor(rand()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }
  function mix(a,b,k) { return a.map((v,i)=>v+(b[i]-v)*k); }
  function hex(c) { return '#' + c.map(v=>Math.round(Math.max(0,Math.min(1,v))*255).toString(16).padStart(2,'0')).join(''); }
  function heart(a, scale) { return [16*Math.sin(a)**3*scale, (13*Math.cos(a)-5*Math.cos(2*a)-2*Math.cos(3*a)-Math.cos(4*a))*scale]; }
  let W,H,DPR,scale,OY,points=[],items=[],start=0,animating=true,shimmerAt=0;
  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    canvas.width = Math.round(W*DPR); canvas.height = Math.round(H*DPR);
    canvas.style.width=W+'px'; canvas.style.height=H+'px';
    ctx.setTransform(DPR,0,0,DPR,0,0);
    // Scale the heart to fit smaller screens while retaining the original composition.
    scale = Math.min(21, W/40, H/43);
    OY = scale*0.95;
    build();
  }
  function build() {
    const poly=[];
    for(let i=0;i<720;i++) poly.push(heart(2*Math.PI*i/720,scale));
    const edges=poly.map((p,i)=>[p,poly[(i+1)%poly.length]]);
    const ymax=Math.max(...poly.map(p=>p[1])), ymin=Math.min(...poly.map(p=>p[1])), cy=(ymax+ymin)/2;
    const rowH=15.5, half=rowH/2;
    function spans(y) {
      const xs=[];
      for(const [[x1,y1],[x2,y2]] of edges) if((y1<=y&&y<y2)||(y2<=y&&y<y1)) xs.push(x1+(y-y1)*(x2-x1)/(y2-y1));
      xs.sort((a,b)=>a-b); const out=[];
      for(let i=0;i<xs.length;i+=2) if(xs[i+1]) out.push([xs[i],xs[i+1]]);
      return out;
    }
    const order=[]; let phraseOrder=[];
    function nextPhrase(){ if(!phraseOrder.length) phraseOrder=shuffle(phrases.slice()); return phraseOrder.pop(); }
    for(let y=ymax-half;y>ymin+half;y-=rowH) {
      let ranges=[];
      for(const a of spans(y+half)) for(const b of spans(y-half)) { const lo=Math.max(a[0],b[0]), hi=Math.min(a[1],b[1]); if(hi-lo>scale*.65) ranges.push([lo,hi]); }
      for(let [lo,hi] of ranges) {
        lo+=scale*.2; hi-=scale*.2; let cur=lo+rand()*scale*.4; const line=[];
        while(cur<hi) {
          let fit=null;
          for(let n=0;n<10;n++) { const text=nextPhrase(), size=sizes[Math.floor(rand()*sizes.length)]; ctx.font=`bold ${size*scale/21}px Arial, sans-serif`; const w=ctx.measureText(text).width; if(cur+w<=hi){fit={text,size,w};break;} }
          if(!fit) break;
          line.push({x:cur+fit.w/2,y,text:fit.text,size:fit.size,w:fit.w}); cur+=fit.w+scale*.33;
        }
        if(!line.length) continue;
        if(line.length>1){const left=hi-(line[line.length-1].x+line[line.length-1].w/2);line.forEach((p,i)=>p.x+=left*i/(line.length-1));}
        else line[0].x=(lo+hi)/2;
        line.forEach((p,i)=>{p.edge=i===0||i===line.length-1; order.push(p);});
      }
    }
    order.forEach(p=>{const rad=Math.min(1,Math.hypot(p.x/(16*scale),(p.y-cy)/(14.5*scale)));let base=mix(colors.wine,colors.crimson,.25+.75*rad);base=mix(base,colors.blood,rand()*.35+(p.edge?.3:0));p.color=base;p.rad=rad;});
    const edge=order.filter(p=>p.edge).sort((a,b)=>Math.atan2(a.x,a.y-cy)-Math.atan2(b.x,b.y-cy));
    const inner=order.filter(p=>!p.edge).sort((a,b)=>b.rad-a.rad+(rand()-.5)*.08);
    items=edge.concat(inner).map(p=>({...p,dx:(rand()*20-10)*scale/21,progress:0}));
    start=performance.now();animating=true;shimmerAt=0;
  }
  function draw(now) {
    ctx.fillStyle=BG;ctx.fillRect(0,0,W,H);
    const elapsed=now-start, duration=10000, rate=items.length/duration;
    const visible=Math.min(items.length,Math.floor(elapsed*rate));
    for(let i=0;i<visible;i++) {
      const p=items[i], u=Math.min(1,(elapsed-(i/rate))/880), e=1-(1-u)**3;
      const x=W/2+p.x+p.dx*(1-e), y=H/2-p.y-(1-e)*34*scale/21;
      const fontSize=p.size*scale/21;
      ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`bold ${fontSize}px Arial, sans-serif`;
      const flash=u>=1 ? 0 : .75*Math.sin(Math.PI*Math.max(0,(u-.55)/.45));
      ctx.fillStyle=hex(mix([.02,.01,.03],mix(p.color,colors.flash,flash),e**1.5));
      ctx.shadowColor=hex(p.color);ctx.shadowBlur=fontSize*.8*e;
      ctx.fillText(p.text,x,y);
      ctx.shadowBlur=0;
    }
    if(visible>=items.length) {
      if(now-shimmerAt>140){shimmerAt=now; const p=items[Math.floor(rand()*items.length)]; p.shineUntil=now+260; }
      for(const p of items) if(p.shineUntil>now) {ctx.font=`bold ${p.size*scale/21}px Arial`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle=hex(mix(p.color,colors.flash,.6));ctx.fillText(p.text,W/2+p.x,H/2-p.y);}
    }
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',resize);
  resize(); requestAnimationFrame(draw);
})();
</script>
</body>
</html>
